# DERIVE runs with zero required env vars — copy this to .env if you want to
# override defaults, regenerate data, or enable optional LLM card copy.

# SQLite file path. Defaults to ./data/derive.sqlite (committed, seeded).
DERIVE_DB_PATH=./data/derive.sqlite

# Nominatim (OSM geocoding) requires a descriptive User-Agent per their usage
# policy — no key needed, just identify your instance.
NOMINATIM_USER_AGENT=derive-dev (you@example.com)

# --- Optional: only needed to run scripts/generate-cards.ts against a live
# model instead of using the committed fallback card copy. The app works
# fully without this — nightly batch output is cached in SQLite and a
# default set ships in the repo.
# ANTHROPIC_API_KEY=

# --- Optional: only needed to re-run scripts/ingest-places.ts against a
# non-default Overpass mirror.
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
